alue>1</b:Value><b:Unit>lb</b:Unit></b:UnitSize><b:Stage>2</b:Stage><b:Duration><b:Text>0.0</b:Text><b:Value>0</b:Value><b:Unit>min</b:Unit></b:Duration><b:Mash>N</b:Mash><b:DryBasisFineGrind><b:Text>0.0%</b:Text><b:Value>0</b:Value></b:DryBasisFineGrind><b:FineCoarseDifference><b:Text>0.0%</b:Text><b:Value>0</b:Value></b:FineCoarseDifference><b:Moisture><b:Text>0.0%</b:Text><b:Value>0</b:Value></b:Moisture><b:Color><b:Text>0.0</b:Text><b:Value>0</b:Value><b:Unit>l</b:Unit></b:Color><b:Protein><b:Text>0.0%</b:Text><b:Value>0</b:Value></b:Protein><b:TotalSolubleNitrogen><b:Text>0.0%</b:Text><b:Value>0</b:Value></b:TotalSolubleNitrogen><b:MaxGrist><b:Text>0</b:Text><b:Value>0</b:Value></b:MaxGrist><b:pH><b:Text>0.0</b:Text><b:Value>0</b:Value></b:pH></b:Extract><b:Special><b:Id>-1</b:Id><b:SourceId>-1</b:SourceId><b:Modified>2026-06-10T00:11:35Z</b:Modified><b:Active>Y</b:Active><b:Name>spceial ingredient</b:Name><b:Origin></b:Origin><b:Supplier></b:Supplier><b:Description><![CDATA[desc]]></b:Description><b:Code></b:Code><b:Quantity><b:Text>0.0</b:Text><b:Value>0</b:Value><b:Unit>tsp</b:Unit></b:Quantity><b:UnitCost><b:Text>5</b:Text><b:Value>5</b:Value><b:Unit>USD</b:Unit></b:UnitCost><b:UnitSize><b:Text>1.0</b:Text><b:Value>1</b:Value><b:Unit>tsp</b:Unit></b:UnitSize><b:Stage>2</b:Stage><b:Duration><b:Text>0.0</b:Text><b:Value>0</b:Value><b:Unit>min</b:Unit></b:Duration></b:Special></b:Ingredients><b:Style><b:Id>91</b:Id><b:SourceId>91</b:SourceId><b:Modified>2024-03-18T06:31:40Z</b:Modified><b:Guide>BJCP 2021</b:Guide><b:Type>1</b:Type><b:Category>Czech Lager</b:Category><b:Subcategory>Czech Dark Lager</b:Subcategory><b:Variant></b:Variant><b:CategoryNumber>3</b:CategoryNumber><b:StyleLetter>D</b:StyleLetter><b:Notes></b:Notes><b:Aroma><![CDATA[Medium to medium-high rich, deep, sometimes sweet maltiness, with optional qualities such as bread crusts, toast, nuts, cola, dark fruit, or caramel. Roasted malt characters such as chocolate or sweetened coffee can vary from moderate to none but should not overwhelm the base malt character. Low to moderate spicy hop aroma optional. Low diacetyl and low to moderate fruity esters (plums or berries) may be present.]]></b:Aroma><b:Appearance><![CDATA[Dark copper to almost black color, often with a red or garnet tint. Clear to bright clarity. Large, off-white to tan, persistent head.]]></b:Appearance><b:Flavor><![CDATA[Medium to medium-high deep, complex maltiness dominates, typically with malty-rich Maillard products and a light to moderate residual malt sweetness. Malt flavors such as caramel, toast, nuts, licorice, dried dark fruit, chocolate, or coffee may also be present, with very low to moderate roast character. Low to moderate spicy hop flavor. Moderate to medium-low bitterness, but should be perceptible. Balance can vary from malty to relatively well-balanced to gently hop-forward. Low to moderate diacetyl and light plum or berry esters may be present.]]></b:Flavor><b:Mouthfeel><![CDATA[Medium to medium-full body, considerable mouthfeel without being heavy or cloying. Moderately creamy in texture. Smooth. Moderate to low carbonation. Can have a slight alcohol warmth in stronger versions.]]></b:Mouthfeel><b:Impression><![CDATA[A rich, dark, malty Czech lager with a roast character that can vary from almost absent to quite prominent. Malty balance and an interesting and complex flavor profile, with variable levels of hopping that provides a range of possible interpretations.]]></b:Impression><b:History><![CDATA[The U Fleků brewery has been operating in Prague since 1499, and produces the best-known version. Many small, new breweries are brewing this style.]]></b:History><b:Ingredients><![CDATA[Pilsner and dark caramel malts with the addition of debittered roasted malts are most common, but additions of Vienna or Munich malt are also appropriate. Low mineral content water. Traditional Czech hops. Czech lager yeast.]]></b:Ingredients><b:Comments><![CDATA[This style is a combination of the Czech styles tmavý ležák (11–12.9 °P) and tmavé speciální pivo (13–14.9 °P). More modern examples are drier and have higher bitterness while traditional versions often have IBUs in the 18–20 range with a sweeter balance.]]></b:Comments><b:Comparison><![CDATA[The beer is the Czech equivalent of a dark lager ranging in character from Munich Dunkel to Schwarzbier, but typically with greater malt richness and hop aroma, flavor, and bitterness.]]></b:Comparison><b:Instructions></b:Instructions><b:Examples><![CDATA[Bernard černý ležák 12°, Budvar tmavý ležák, Herold tmavé silné pivo 13°, Kozel Dark , Krušovice  černé, Primátor dark lager, U Fleků Flekovský tmavý ležák 13°]]></b:Examples><b:Tags><![CDATA[standard-strength, dark-color, bottom-fermented, lagered, central-europe, traditional-style, dark-lager-family, balanced]]></b:Tags><b:OriginalGravityMin><b:Text>1.044</b:Text><b:Value>1.044</b:Value><b:Unit>sg</b:Unit></b:OriginalGravityMin><b:OriginalGravityMax><b:Text>1.060</b:Text><b:Value>1.06</b:Value><b:Unit>sg</b:Unit></b:OriginalGravityMax><b:TerminalGravityMin><b:Text>1.013</b:Text><b:Value>1.013</b:Value><b:Unit>sg</b:Unit></b:TerminalGravityMin><b:TerminalGravityMax><b:Text>1.017</b:Text><b:Value>1.017</b:Value><b:Unit>sg</b:Unit></b:TerminalGravityMax><b:ColorMin><b:Text>17.0</b:Text><b:Value>17</b:Value><b:Unit>srm</b:Unit></b:ColorMin><b:ColorMax><b:Text>35.0</b:Text><b:Value>35</b:Value><b:Unit>srm</b:Unit></b:ColorMax><b:AlcoholMin><b:Text>4.4%</b:Text><b:Value>0.044</b:Value></b:AlcoholMin><b:AlcoholMax><b:Text>5.8%</b:Text><b:Value>0.058</b:Value></b:AlcoholMax><b:BitternessMin><b:Text>18.0</b:Text><b:Value>18</b:Value></b:BitternessMin><b:BitternessMax><b:Text>34.0</b:Text><b:Value>34</b:Value></b:BitternessMax></b:Style><b:WaterChemistry><b:Target><b:Id>-1</b:Id><b:SourceId>-1</b:SourceId><b:Modified>2026-06-10T00:05:37Z</b:Modified><b:Active>Y</b:Active><b:Name>Untitled Water Profile</b:Name><b:Origin></b:Origin><b:Supplier></b:Supplier><b:Descri